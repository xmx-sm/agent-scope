# 复制为 .env 后按需修改；.env 不入库（见仓库根 .gitignore）
# --- 应用 ---
APP_NAME=Agent Scope Platform
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
# 开发时允许的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5182,http://127.0.0.1:5182

# --- 数据库（PostgreSQL + asyncpg）---
# 密码中的特殊字符需要 URL 编码
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/agent_scope
# 应用连接池（修改后需要重启；所有 Worker 合计不要超过 PostgreSQL max_connections）
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis（限流；不可用时自动降级进程内）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=100
RATE_LIMIT_ENABLED=true

# --- 鉴权 ---
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
# 机器人凭据加密密钥；留空时派生自 JWT_SECRET，生产建议单独配置
BOT_CREDENTIAL_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 标准 A2A（JSON-RPC 1.0，可选）---
# 先安装可选依赖：uv pip install --python .venv/bin/python -r backend/requirements-a2a.txt
# 再设为 true；不安装/不开启时仅标准 A2A 不可用，A2A Lite 不受影响
A2A_STANDARD_ENABLED=false
# 对外可访问的站点根地址，例如 https://agent.example.com/agent_scope
# 留空时 Agent Card 使用 http://127.0.0.1:${PORT}
A2A_PUBLIC_URL=
A2A_AGENT_NAME=Agent Scope
A2A_AGENT_DESCRIPTION=Agent Scope 标准 A2A 智能体

# --- 业务默认值（首次启动写入 system_configs，之后以数据库为准）---
ALLOW_REGISTER=true
DEFAULT_ROLE=user


# --- 首次启动账号（已有数据库不会覆盖）---
# 生产环境务必改成强密码；演示账号可关闭
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=000000
SEED_ADMIN_NICKNAME=admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_DEMO_USERS=true
