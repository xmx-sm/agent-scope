# 复制为 .env 后按需修改；.env 不入库（见仓库根 .gitignore）
# --- 应用 ---
APP_NAME=Agent Scope Platform
APP_ENV=dev
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api
# 开发时允许的前端地址，逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- 数据库（PostgreSQL + asyncpg）---
# 密码中的特殊字符需要 URL 编码
DATABASE_URL=postgresql+asyncpg://mx:990108@127.0.0.1:5432/agent_scope

# --- Redis（限流；不可用时自动降级进程内）---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=990108
RATE_LIMIT_ENABLED=true

# --- 鉴权 ---
# 生产环境务必替换为随机长字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 业务默认值（首次启动写入 system_configs，之后以数据库为准）---
ALLOW_REGISTER=true
DEFAULT_ROLE=user
